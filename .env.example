# Leave unset to run the dashboard in browser-safe simulation mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Chat model (optional): any OpenAI-compatible server, e.g. a locally hosted model reached over Tailscale ---
# AI_BASE_URL=https://your-host.your-tailnet.ts.net/v1
# AI_MODEL=Org/Model-Name
# AI_API_KEY=the-key-your-server-expects   # sent only to AI_BASE_URL, never the Gemini key
# AI_FAST_MODEL=                            # optional lighter model for small talk (empty = use AI_MODEL)
# AI_TIMEOUT=60                             # seconds to wait for it before falling back to Gemini
# With GEMINI_API_KEY also set, Gemini answers if the server is unreachable, slow or erroring, and always handles
# images/PDFs, voice notes, web research and search-by-meaning. Override its model names with GEMINI_MODEL / GEMINI_FAST_MODEL.
