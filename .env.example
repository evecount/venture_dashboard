# Leave unset to run the dashboard in browser-safe simulation mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Locally hosted chat model (optional): any OpenAI-compatible server, e.g. reached over Tailscale ---
# These are separate from AI_* / GEMINI_*: setting them changes nothing about the Gemini settings.
# LOCAL_LLM_BASE_URL=https://your-host.your-tailnet.ts.net/v1
# LOCAL_LLM_MODEL=Org/Model-Name
# LOCAL_LLM_API_KEY=the-key-your-server-expects   # sent only to LOCAL_LLM_BASE_URL, never the Gemini key
# LOCAL_LLM_FAST_MODEL=                            # optional lighter model for small talk (empty = LOCAL_LLM_MODEL)
# LOCAL_LLM_TIMEOUT=60                             # seconds to wait before falling back to Gemini
# When both are set the local model answers chat first; Gemini (AI_* / GEMINI_API_KEY) answers if the server is unreachable,
# slow or erroring, and always handles images/PDFs, voice notes, web research and search-by-meaning.
